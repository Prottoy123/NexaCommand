generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==========================================
// 1. ENUMS (Global Definitions)
// ==========================================
enum BusinessType {
  RETAIL
  CORPORATE
  AGENCY
}

enum SubscriptionStatus {
  ACTIVE
  EXPIRED
  SUSPENDED
}

enum PlanType {
  FREE
  PRO
  ENTERPRISE
}

enum BillingCycle {
  MONTHLY
  YEARLY
  LIFETIME   
}

enum UserRole {
  SUPER_ADMIN
  ORG_OWNER
  HR               
  BRANCH_MANAGER
  STAFF
}

enum UserStatus {
  PENDING
  ACTIVE
  SUSPENDED
}

enum ItemType {
  PHYSICAL_GOOD
  DIGITAL_SERVICE
}

enum InvoiceType {
  POS_RECEIPT
  B2B_INVOICE
}

enum InvoiceStatus {
  PAID
  PENDING
  OVERDUE
}

enum PaymentMethod {
  CASH
  CARD
  BANK_TRANSFER
  UNPAID
}

enum LedgerEventType {
  POS_REVENUE
  B2B_REVENUE
  SALARY_PAID
  EWA_ADVANCE
  BOUNTY_CREDITED
  REFUND_PROCESSED
  EXPENSE_RECORDED 
}

enum EwaStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ExpenseCategory {
  RENT
  UTILITIES
  SUPPLIES
  MARKETING
  MAINTENANCE
  OTHER
}

enum WorkflowStatus {
  PENDING
  IN_PROGRESS
  APPROVED
  REJECTED
}

enum StepAction {
  SUBMITTED
  APPROVED_AND_FORWARDED
  FINAL_APPROVED
  REJECTED
}

enum ReferenceType {
  INVOICE
  EWA_REQUEST
  USER
  PAYROLL
  EXPENSE          
  DOCUMENT         
}

// ==========================================
// 2. TENANT & SUBSCRIPTION (SaaS Core)
// ==========================================
model Tenant {
  id                 String               @id @default(uuid())
  name               String
  businessType       BusinessType
  subscriptionStatus SubscriptionStatus @default(ACTIVE)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  tenantCode         String             @unique
  
  subscription       PlatformSubscription?
  
  // Opposite relation fields required by Prisma
  branches           Branch[]
  users              User[]
  catalogItems       CatalogItem[]
  invoices           Invoice[]
  ledgerEvents       LedgerEvent[]
  ewaRequests        EwaRequest[]
  auditLogs          AuditLog[]
  expenses           Expense[]          
  documents          DocumentRequest[]  
  approvalSteps      DocumentApprovalStep[] 

  @@map("tenants")
}

model PlatformSubscription {
  id              String       @id @default(uuid())
  tenantId        String       @unique
  tenant          Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  plan            PlanType     @default(FREE)
  billingCycle    BillingCycle @default(LIFETIME)
  startDate       DateTime     @default(now())
  nextBillingDate DateTime?    
  isActive        Boolean      @default(true)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@map("platform_subscriptions")
}

// ==========================================
// 3. BRANCH & RBAC (Operations)
// ==========================================
model Branch {
  id            String   @id @default(uuid())
  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  
  name          String
  location      String
  contactNumber String

  managerId     String?  @unique
  manager       User?    @relation("BranchManager", fields: [managerId], references: [id])
  staff         User[]   @relation("BranchStaff")
  
  catalogItems  CatalogItem[]
  invoices      Invoice[]
  expenses      Expense[] 
  documents     DocumentRequest[] 

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("branches")
}

model User {
  id              String     @id @default(uuid())
  tenantId        String
  tenant          Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  staffId         String?    @unique 

  googleId        String?    @unique

  branchId        String?
  // Use SetNull to avoid deleting staff if a branch is deleted
  branch          Branch?    @relation("BranchStaff", fields: [branchId], references: [id], onDelete: SetNull)
  managedBranch   Branch?    @relation("BranchManager")
  
  email           String      
  fullName        String
  password        String
  
  // Identity & Org Chart Fields
  designation     String?    @default("Staff") 
  department      String?                      
  
  avatarUrl       String?
  role            UserRole   
  status          UserStatus @default(PENDING)
  
  baseSalary      Decimal    @default(0)
  earnedCommission Decimal   @default(0)
  refreshToken    String?

  forgotPasswordToken  String?
  forgotPasswordExpiry DateTime?
  
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  // Opposite relations required by Prisma
  createdInvoices Invoice[]    @relation("InvoiceCreator")
  ewaRequests     EwaRequest[] @relation("EwaStaff")
  approvedEwas    EwaRequest[] @relation("EwaApprover")
  auditLogs       AuditLog[]   @relation("UserAudit")
  
  expensesRecorded  Expense[]              @relation("ExpenseRecorder")
  documentsCreated  DocumentRequest[]      @relation("DocumentCreator")
  documentsAssigned DocumentRequest[]      @relation("DocumentAssignee")
  approvalSteps     DocumentApprovalStep[] @relation("StepReviewer")
  forwardedSteps    DocumentApprovalStep[] @relation("StepForwardedTo")

  @@unique([email, tenantId]) // Composite Unique for Multi-tenant isolation
  @@map("users")
}

// ==========================================
// 4. THE UNIVERSAL CATALOG (Inventory & Services)
// ==========================================
model CatalogItem {
  id              String    @id @default(uuid())
  tenantId        String
  tenant          Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branchId        String?
  branch          Branch?   @relation(fields: [branchId], references: [id], onDelete: SetNull)

  name            String
  sku             String    
  price           Decimal
  itemType        ItemType

  stock           Int?
  lastRestockedAt DateTime?
  
  bountyAmount    Decimal   @default(0)
  imageUrl        String?

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  invoiceItems    InvoiceItem[]

  @@map("catalog_items")
}

// ==========================================
// 5. UNIFIED BILLING ENGINE
// ==========================================
model Invoice {
  id              String        @id @default(uuid())
  tenantId        String
  tenant          Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branchId        String
  branch          Branch        @relation(fields: [branchId], references: [id])
  
  creatorId       String
  creator         User          @relation("InvoiceCreator", fields: [creatorId], references: [id])

  clientName      String?
  clientPhone     String?
  clientEmail     String?

  invoiceType     InvoiceType
  status          InvoiceStatus
  
  totalAmount     Decimal
  discountAmount  Decimal       @default(0)
  netPayable      Decimal
  
  paymentMethod   PaymentMethod
  dueDate         DateTime?

  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  items           InvoiceItem[]

  @@map("invoices")
}

model InvoiceItem {
  id            String      @id @default(uuid())
  
  invoiceId     String
  invoice       Invoice     @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  
  catalogItemId String
  catalogItem   CatalogItem @relation(fields: [catalogItemId], references: [id])

  quantity      Int
  unitPrice     Decimal
  subTotal      Decimal

  @@map("invoice_items")
}

// ==========================================
// 6. FINANCE & OPERATIONS (Immutable Core)
// ==========================================
model LedgerEvent {
  id              String          @id @default(uuid())
  tenantId        String
  tenant          Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  
  transactionId   String          @unique
  eventType       LedgerEventType
  
  debitAccount    String
  creditAccount   String
  amount          Decimal

  referenceId     String          
  referenceType   ReferenceType   

  createdAt       DateTime        @default(now())

  @@map("ledger_events")
}

model EwaRequest {
  id              String      @id @default(uuid())
  tenantId        String
  tenant          Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  
  staffId         String
  staff           User        @relation("EwaStaff", fields: [staffId], references: [id])

  requestedAmount Decimal
  status          EwaStatus   @default(PENDING)

  approvedById    String?
  approvedBy      User?       @relation("EwaApprover", fields: [approvedById], references: [id])
  
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@map("ewa_requests")
}

model AuditLog {
  id              String      @id @default(uuid())
  tenantId        String
  tenant          Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  
  userId          String
  user            User        @relation("UserAudit", fields: [userId], references: [id])

  action          String
  targetResource  String
  
  createdAt       DateTime    @default(now())

  @@map("audit_logs")
}

// ==========================================
// 7. EXPENSE MANAGEMENT (Petty Cash & Bills) 
// ==========================================
model Expense {
  id              String          @id @default(uuid())
  tenantId        String
  tenant          Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branchId        String?
  branch          Branch?         @relation(fields: [branchId], references: [id], onDelete: SetNull)
  
  recordedById    String
  recordedBy      User            @relation("ExpenseRecorder", fields: [recordedById], references: [id])

  category        ExpenseCategory
  amount          Decimal
  description     String
  receiptUrl      String?

  createdAt       DateTime        @default(now())

  @@map("expenses")
}

// ==========================================
// 8. ENTERPRISE E-FILING (Document Workflow) 
// ==========================================
model DocumentRequest {
  id                String                 @id @default(uuid())
  tenantId          String
  tenant            Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  
  branchId          String?
  branch            Branch?                @relation(fields: [branchId], references: [id], onDelete: SetNull)

  title             String
  description       String?
  fileUrl           String
  fileType          String                 // e.g., PDF, DOCX, XLSX, IMAGE
  
  creatorId         String
  creator           User                   @relation("DocumentCreator", fields: [creatorId], references: [id])
  
  currentAssigneeId String
  currentAssignee   User                   @relation("DocumentAssignee", fields: [currentAssigneeId], references: [id])

  status            WorkflowStatus         @default(PENDING)
  
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt

  approvalSteps     DocumentApprovalStep[]

  @@map("document_requests")
}

model DocumentApprovalStep {
  id                String           @id @default(uuid())
  tenantId          String
  tenant            Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  
  documentRequestId String
  documentRequest   DocumentRequest  @relation(fields: [documentRequestId], references: [id], onDelete: Cascade)
  
  stepNumber        Int
  
  reviewerId        String
  reviewer          User             @relation("StepReviewer", fields: [reviewerId], references: [id])
  
  forwardedToId     String?
  forwardedTo       User?            @relation("StepForwardedTo", fields: [forwardedToId], references: [id])
  
  action            StepAction
  remarks           String?
  
  actionAt          DateTime         @default(now())

  @@map("document_approval_steps")
}